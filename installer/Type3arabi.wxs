<?xml version="1.0" encoding="utf-8"?>
<!--
  Type3arabi MSI (docs/07 §5). Build: scripts/build-installer.ps1 (WiX v5).
  Per-machine, x64 package carrying the x64 and x86 TIP DLLs (one CLSID, both registry views).
  Registration runs regsvr32 on each DLL, i.e. our DllRegisterServer, which uses TSF APIs only (R6).
  Finish page: "Restart now (recommended)" is checked; unchecking it shows a warning explaining what may
  not work until the next restart (Owner request 2026-09-23).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="$(var.ProductName)"
           Manufacturer="Type3arabi"
           Version="$(var.Version)"
           UpgradeCode="C71F4AAE-43FF-47DA-B6F0-582B0611BAF6"
           Scope="perMachine"
           Compressed="yes">

    <!-- Same-version upgrades: release candidates (1.0.0-rc.N => MSI 1.0.0.N; the 4th field is ignored in
         version comparisons) and the final 1.0.0 replace each other. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of Type3arabi is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="Type3arabi.ico" SourceFile="$(var.Payload)\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="Type3arabi.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://type3arabi.com/" />
    <Property Id="ARPHELPLINK" Value="https://github.com/ArabSeven/type3arabi/issues" />
    <!-- Uninstall with a choice (Owner, 2026-09-26). Windows removes an MSI from Settings > Apps with a
         progress bar only (no dialogs), so the MSI's own Apps entry is hidden and the ArpEntry component
         below writes the one users see: its Uninstall runs this package in full UI (maintenance mode),
         which shows T3RemoveDlg (keep or erase learned words) and a finish page saying what happened. -->
    <Property Id="ARPSYSTEMCOMPONENT" Value="1" />
    <!-- Erase the uninstalling user's learned words and settings; off by default (T3RemoveDlg checkbox,
         or ERASEUSERDATA=1 on the command line). -->
    <Property Id="ERASEUSERDATA" Secure="yes" />

    <!-- Files in use (docs/07 §5). The keyboard DLL is loaded by every app the user types in, so an
         upgrade always finds it in use. Never let Windows Installer close those apps (Restart Manager
         would shut them down in a silent /qn install, e.g. from the Microsoft Store) and never let it
         restart the PC on its own: in-use files are replaced at the next restart, msiexec returns 3010
         (restart required), and the finish page of an interactive install offers the restart.
         MSIRESTARTMANAGERCONTROL only works when authored in the Property table (not from a custom action). -->
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />
    <Property Id="REBOOT" Value="ReallySuppress" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Type3arabi">
        <Directory Id="X64DIR" Name="x64" />
        <Directory Id="X86DIR" Name="x86" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />
    <!-- Desktop shortcut to Settings (Owner, 2026-09-25): on by default; the Options page can turn it off
         (silent installs: DESKTOPSHORTCUT=""). Per-machine install => the Public desktop. -->
    <Property Id="DESKTOPSHORTCUT" Value="1" Secure="yes" />

    <ComponentGroup Id="Core" Directory="INSTALLFOLDER">
      <Component Id="TipX64" Directory="X64DIR" Bitness="always64">
        <File Id="TipX64Dll" Source="$(var.Payload)\x64\t3a_tip.dll" KeyPath="yes" />
      </Component>
      <!-- The x86 DLL is only a file here: its registration is done by the 32-bit regsvr32. -->
      <Component Id="TipX86" Directory="X86DIR">
        <File Id="TipX86Dll" Source="$(var.Payload)\x86\t3a_tip.dll" KeyPath="yes" />
      </Component>
      <Component Id="Data">
        <File Id="DataFile" Source="$(var.Payload)\type3arabi.dat" KeyPath="yes" />
      </Component>
      <Component Id="Notice">
        <File Id="NoticeFile" Source="$(var.Payload)\NOTICE.md" KeyPath="yes" />
      </Component>
      <Component Id="Datasets">
        <File Id="DatasetsFile" Source="$(var.Payload)\DATASETS.md" KeyPath="yes" />
      </Component>
      <Component Id="Copyright">
        <File Id="CopyrightFile" Source="$(var.Payload)\COPYRIGHT.md" KeyPath="yes" />
      </Component>
      <Component Id="ThirdPartyLicenses">
        <File Id="ThirdPartyFile" Source="$(var.Payload)\THIRD-PARTY-LICENSES.html" KeyPath="yes" />
      </Component>
      <Component Id="LicenseText">
        <File Id="LicenseFile" Name="LICENSE.txt" Source="$(var.Payload)\LICENSE" KeyPath="yes" />
      </Component>
      <Component Id="Hotkey">
        <File Id="HotkeyExe" Source="$(var.Payload)\t3a-hotkey.exe" KeyPath="yes" />
        <!-- The companion exits at once if the user disabled the global hotkey (docs/02 §11). -->
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Run"
                       Name="Type3arabi Hotkey" Type="string" Value="&quot;[#HotkeyExe]&quot;" />
        <!-- Our own key (desktop-shortcut marker): gone after uninstall, even if left empty. -->
        <RemoveRegistryKey Action="removeOnUninstall" Root="HKLM" Key="Software\Type3arabi" />
        <!-- Learned words and settings, only when ERASEUSERDATA=1: the paths are set by the SetProperty
             actions below and stay empty otherwise (RemoveFolderEx then does nothing). -->
        <util:RemoveFolderEx Id="EraseLocal" On="uninstall" Property="T3ERASE_LOCAL" />
        <util:RemoveFolderEx Id="EraseSettingsWebView" On="uninstall" Property="T3ERASE_WEBVIEW" />
        <util:RemoveFolderEx Id="EraseRoaming" On="uninstall" Property="T3ERASE_ROAMING" />
      </Component>
      <!-- The Apps entry (see ARPSYSTEMCOMPONENT): Uninstall = this package in full UI. -->
      <Component Id="ArpEntry">
        <RegistryKey Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\Type3arabi" ForceDeleteOnUninstall="yes">
          <RegistryValue Name="DisplayName" Type="string" Value="[ProductName]" KeyPath="yes" />
          <RegistryValue Name="DisplayVersion" Type="string" Value="[ProductVersion]" />
          <RegistryValue Name="Publisher" Type="string" Value="[Manufacturer]" />
          <RegistryValue Name="DisplayIcon" Type="string" Value="[#SettingsExe],0" />
          <RegistryValue Name="InstallLocation" Type="string" Value="[INSTALLFOLDER]" />
          <RegistryValue Name="URLInfoAbout" Type="string" Value="[ARPURLINFOABOUT]" />
          <RegistryValue Name="HelpLink" Type="string" Value="[ARPHELPLINK]" />
          <RegistryValue Name="UninstallString" Type="string" Value="MsiExec.exe /I[ProductCode]" />
          <RegistryValue Name="QuietUninstallString" Type="string" Value="MsiExec.exe /X[ProductCode] /qn" />
          <RegistryValue Name="NoModify" Type="integer" Value="1" />
          <RegistryValue Name="NoRepair" Type="integer" Value="1" />
        </RegistryKey>
      </Component>
      <Component Id="Settings">
        <File Id="SettingsExe" Name="Type3arabi Settings.exe" Source="$(var.Payload)\Type3arabi Settings.exe" KeyPath="yes">
          <Shortcut Id="SettingsShortcut" Directory="ProgramMenuFolder" Name="Type3arabi Settings"
                    Description="Shortcuts, typing and diacritics options for Type3arabi"
                    WorkingDirectory="INSTALLFOLDER" Icon="Type3arabi.ico" Advertise="yes" />
        </File>
      </Component>
      <Component Id="DesktopShortcut" Directory="DesktopFolder" Condition="DESKTOPSHORTCUT = 1">
        <Shortcut Id="SettingsDesktopShortcut" Name="Type3arabi Settings" Target="[#SettingsExe]"
                  Description="Shortcuts, typing and diacritics options for Type3arabi"
                  WorkingDirectory="INSTALLFOLDER" Icon="Type3arabi.ico" />
        <RegistryValue Root="HKLM" Key="Software\Type3arabi" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="Type3arabi" Level="1">
      <ComponentGroupRef Id="Core" />
    </Feature>

    <!-- ===== Registration (deferred, elevated) ===== -->
    <CustomAction Id="RegisterX64" Directory="INSTALLFOLDER" Execute="deferred" Impersonate="no" Return="check"
                  ExeCommand="&quot;[System64Folder]regsvr32.exe&quot; /s &quot;[#TipX64Dll]&quot;" />
    <CustomAction Id="RegisterX86" Directory="INSTALLFOLDER" Execute="deferred" Impersonate="no" Return="check"
                  ExeCommand="&quot;[SystemFolder]regsvr32.exe&quot; /s &quot;[#TipX86Dll]&quot;" />
    <CustomAction Id="UnregisterX64" Directory="INSTALLFOLDER" Execute="deferred" Impersonate="no" Return="ignore"
                  ExeCommand="&quot;[System64Folder]regsvr32.exe&quot; /s /u &quot;[#TipX64Dll]&quot;" />
    <CustomAction Id="UnregisterX86" Directory="INSTALLFOLDER" Execute="deferred" Impersonate="no" Return="ignore"
                  ExeCommand="&quot;[SystemFolder]regsvr32.exe&quot; /s /u &quot;[#TipX86Dll]&quot;" />

    <!-- ===== Per-user steps (immediate, as the installing user) ===== -->
    <!-- Console tools run through WiX's QuietExec (no console window, also in silent installs). Immediate
         QuietExec reads its command line from WixQuietExec64CmdLine, set just before each run. -->
    <CustomAction Id="SetStopHotkeyCmd" Property="WixQuietExec64CmdLine"
                  Value="&quot;[System64Folder]taskkill.exe&quot; /F /IM t3a-hotkey.exe" />
    <CustomAction Id="StopHotkey" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec64"
                  Execute="immediate" Return="ignore" />
    <CustomAction Id="EnableProfile" Directory="INSTALLFOLDER" Execute="immediate" Return="ignore"
                  ExeCommand="&quot;[#HotkeyExe]&quot; --enable-profile" />
    <CustomAction Id="DisableProfile" Directory="INSTALLFOLDER" Execute="immediate" Return="ignore"
                  ExeCommand="&quot;[#HotkeyExe]&quot; --disable-profile" />
    <CustomAction Id="StartHotkey" Directory="INSTALLFOLDER" Execute="immediate" Return="asyncNoWait"
                  ExeCommand="&quot;[#HotkeyExe]&quot;" />

    <!-- ===== Finish page actions ===== -->
    <CustomAction Id="SetRestartCmd" Property="WixQuietExec64CmdLine"
                  Value="&quot;[System64Folder]shutdown.exe&quot; /r /t 20 /c &quot;Restarting to finish installing Type3arabi.&quot;" />
    <CustomAction Id="RestartNow" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec64"
                  Execute="immediate" Return="ignore" />
    <CustomAction Id="RestartWarning" Directory="INSTALLFOLDER" Execute="immediate" Return="asyncNoWait"
                  ExeCommand="&quot;[#HotkeyExe]&quot; --restart-warning" />

    <!-- Erase paths for the user running the uninstall; only a full removal, never an upgrade. -->
    <SetProperty Id="T3ERASE_LOCAL" Value="[LocalAppDataFolder]Type3arabi" Before="Wix4RemoveFoldersEx_X64"
                 Sequence="execute" Condition="ERASEUSERDATA = 1 AND REMOVE = &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    <SetProperty Id="T3ERASE_WEBVIEW" Value="[LocalAppDataFolder]com.type3arabi.settings" Before="Wix4RemoveFoldersEx_X64"
                 Sequence="execute" Condition="ERASEUSERDATA = 1 AND REMOVE = &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    <SetProperty Id="T3ERASE_ROAMING" Value="[AppDataFolder]Type3arabi" Before="Wix4RemoveFoldersEx_X64"
                 Sequence="execute" Condition="ERASEUSERDATA = 1 AND REMOVE = &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />

    <InstallExecuteSequence>
      <Custom Action="SetStopHotkeyCmd" Before="StopHotkey" />
      <Custom Action="StopHotkey" Before="InstallValidate" />
      <Custom Action="DisableProfile" Before="InstallInitialize"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="UnregisterX64" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot;" />
      <Custom Action="UnregisterX86" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot;" />
      <Custom Action="RegisterX64" After="InstallFiles" Condition="NOT REMOVE" />
      <Custom Action="RegisterX86" After="RegisterX64" Condition="NOT REMOVE" />
      <Custom Action="EnableProfile" After="InstallFinalize" Condition="NOT REMOVE" />
      <Custom Action="StartHotkey" After="EnableProfile" Condition="NOT REMOVE" />
    </InstallExecuteSequence>

    <!-- ===== UI: license, progress, finish with the restart choice ===== -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.Payload)\License.rtf" />
    <!-- Brand art (installer/*.bmp, from the brand kit): welcome/finish panel and the inner-page banner. -->
    <WixVariable Id="WixUIDialogBmp" Value="$(var.Payload)\WixUIDialog.bmp" />
    <WixVariable Id="WixUIBannerBmp" Value="$(var.Payload)\WixUIBanner.bmp" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT"
              Value="Restart now (recommended) — apps that are already open load Type3arabi after a restart." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT"
              Value="Type3arabi is installed. Press Win+Space and choose Arabic (Saudi Arabia) · Type3arabi, or use Ctrl+Alt+A. Shortcuts can be changed in Type3arabi Settings." />
    <!-- Finish page title/description: Type3arabi.wxl routes them through these; T3RemoveDlg changes them. -->
    <Property Id="T3EXITTITLE" Value="Completed the Type3arabi Setup Wizard" />
    <Property Id="T3EXITDESCRIPTION" Value="Click the Finish button to exit the Setup Wizard." />
    <UI>
      <ui:WixUI Id="WixUI_Minimal" />
      <!-- "What Type3arabi adds" (after the license page): discloses every system change (Store policy
           10.2.7/10.2.8, SignPath "announce system changes"); same list in README.md and docs/07 §5. -->
      <Dialog Id="T3OptionsDlg" Width="370" Height="270" Title="!(loc.WelcomeEulaDlg_Title)">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}What Type3arabi adds" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="300" Height="15" Transparent="yes" NoPrefix="yes" Text="!(loc.T3ChangesIntro)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="Changes" Type="Text" X="20" Y="52" Width="335" Height="126" NoPrefix="yes" Text="!(loc.T3Changes)" />
        <Control Id="DesktopShortcutBox" Type="CheckBox" X="20" Y="182" Width="330" Height="16" Property="DESKTOPSHORTCUT" CheckBoxValue="1" Text="Create a desktop shortcut for Type3arabi Settings" />
        <Control Id="Note" Type="Text" X="20" Y="202" Width="335" Height="28" NoPrefix="yes" Text="!(loc.T3UninstallNote)" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Install" Type="PushButton" ElevationShield="yes" X="212" Y="243" Width="80" Height="17" Default="yes" Text="!(loc.VerifyReadyDlgInstall)">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>
      <!-- Maintenance mode (Apps > Uninstall, or opening the MSI again): uninstall, keep or erase learned words. -->
      <Dialog Id="T3RemoveDlg" Width="370" Height="270" Title="!(loc.WelcomeEulaDlg_Title)">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}!(loc.T3RemoveTitle)" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="300" Height="15" Transparent="yes" NoPrefix="yes" Text="!(loc.T3RemoveIntro)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="Body" Type="Text" X="20" Y="56" Width="335" Height="80" NoPrefix="yes" Text="!(loc.T3RemoveBody)" />
        <Control Id="EraseBox" Type="CheckBox" X="20" Y="146" Width="335" Height="16" Property="ERASEUSERDATA" CheckBoxValue="1" Text="!(loc.T3RemoveErase)" />
        <Control Id="EraseNote" Type="Text" X="36" Y="164" Width="319" Height="40" NoPrefix="yes" Text="!(loc.T3RemoveEraseNote)" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Uninstall" Type="PushButton" ElevationShield="yes" X="212" Y="243" Width="80" Height="17" Default="yes" Text="!(loc.T3RemoveButton)">
          <Publish Property="WixUI_InstallMode" Value="Remove" Order="1" />
          <Publish Property="T3EXITTITLE" Value="!(loc.T3RemovedTitle)" Order="2" />
          <Publish Property="T3EXITDESCRIPTION" Value="!(loc.T3RemovedKept)" Condition="ERASEUSERDATA &lt;&gt; 1" Order="3" />
          <Publish Property="T3EXITDESCRIPTION" Value="!(loc.T3RemovedErased)" Condition="ERASEUSERDATA = 1" Order="4" />
          <!-- Skips WixUI's MaintenanceWelcomeDlg (shown only when NOT Preselected). -->
          <Publish Property="Preselected" Value="1" Order="5" />
          <Publish Event="Remove" Value="All" Order="6" />
          <Publish Event="EndDialog" Value="Return" Order="7" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>
      <InstallUISequence>
        <Show Dialog="T3OptionsDlg" After="WelcomeEulaDlg" Condition="NOT Installed" />
        <Show Dialog="T3RemoveDlg" Before="MaintenanceWelcomeDlg" Condition="Installed AND NOT RESUME AND NOT Preselected AND NOT PATCH" />
      </InstallUISequence>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="SetRestartCmd"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" Order="1" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="RestartNow"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" Order="2" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="RestartWarning"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX &lt;&gt; 1 AND NOT Installed" />
    </UI>
  </Package>
</Wix>
