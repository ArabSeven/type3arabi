{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Type3arabi",
  "version": "1.0.0-rc.2",
  "identifier": "com.type3arabi.settings",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Type3arabi Settings — إعدادات «اكتب عربي»",
        "width": 820,
        "height": 640,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "publisher": "Type3arabi",
    "copyright": "© 2026 Hassan Obaida. Apache-2.0",
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
